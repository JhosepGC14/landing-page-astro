---
import { NAV_LINKS, SITE } from '../../lib/site';
import Logo from '../Logo.astro';
---

<header
	id="site-header"
	class="fixed inset-x-0 top-0 z-30 flex justify-center px-4 pt-4 transition-all duration-300 md:pt-6"
	data-state="top"
>
	<nav
		aria-label="Principal"
		class="group/header flex w-full max-w-7xl items-center justify-between gap-6 rounded-full border border-transparent px-4 py-2.5 transition-all duration-300 md:px-6 data-[scrolled=true]:border-white/10 data-[scrolled=true]:bg-black/50 data-[scrolled=true]:backdrop-blur-xl data-[scrolled=true]:max-w-5xl"
		data-scrolled="false"
	>
		<Logo class="shrink-0" />

		<ul class="hidden items-center gap-8 lg:flex">
			{
				NAV_LINKS.map((link) => (
					<li>
						<a
							href={link.href}
							class="text-sm text-white/70 transition-colors hover:text-white"
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<div class="flex items-center gap-3">
			<a
				href={SITE.subscriptionsUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex h-10 items-center gap-2 rounded-full bg-white px-5 text-sm font-medium text-black transition-all hover:bg-white/90 active:scale-[0.98]"
			>
				Empieza tu chequeo
			</a>
			<button
				type="button"
				class="inline-flex size-10 items-center justify-center rounded-full text-white lg:hidden"
				aria-label="Abrir menú"
				data-mobile-menu-trigger
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-5"
					aria-hidden="true"
				>
					<line x1="4" x2="20" y1="7" y2="7"></line>
					<line x1="4" x2="20" y1="17" y2="17"></line>
				</svg>
			</button>
		</div>
	</nav>
</header>

<!-- Mobile menu (TODO: refactor to a React island if it grows in features) -->
<div
	data-mobile-menu
	class="fixed inset-0 z-40 hidden flex-col bg-black/95 backdrop-blur-xl"
	aria-hidden="true"
>
	<div class="flex items-center justify-between px-6 pt-6">
		<Logo />
		<button
			type="button"
			class="inline-flex size-10 items-center justify-center rounded-full text-white"
			aria-label="Cerrar menú"
			data-mobile-menu-close
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.75"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-6"
				aria-hidden="true"
			>
				<path d="M18 6 6 18"></path>
				<path d="m6 6 12 12"></path>
			</svg>
		</button>
	</div>
	<ul class="flex flex-1 flex-col items-center justify-center gap-8 px-6">
		{
			NAV_LINKS.map((link) => (
				<li>
					<a
						href={link.href}
						class="text-2xl font-medium tracking-tight text-white"
						data-mobile-menu-link
					>
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</div>

<script>
	const initHeader = (): void => {
		const nav = document.querySelector('#site-header nav') as HTMLElement | null;
		if (!nav) return;

		const onScroll = (): void => {
			nav.dataset.scrolled = window.scrollY > 24 ? 'true' : 'false';
		};
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		const trigger = document.querySelector(
			'[data-mobile-menu-trigger]',
		) as HTMLElement | null;
		const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
		const close = document.querySelector('[data-mobile-menu-close]') as HTMLElement | null;
		const links = document.querySelectorAll('[data-mobile-menu-link]');

		const openMenu = (): void => {
			if (!menu) return;
			menu.classList.remove('hidden');
			menu.classList.add('flex');
			menu.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
		};

		const closeMenu = (): void => {
			if (!menu) return;
			menu.classList.add('hidden');
			menu.classList.remove('flex');
			menu.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
		};

		trigger?.addEventListener('click', openMenu);
		close?.addEventListener('click', closeMenu);
		links.forEach((link) => link.addEventListener('click', closeMenu));
	};

	initHeader();
	document.addEventListener('astro:page-load', initHeader);
</script>
