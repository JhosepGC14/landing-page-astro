---
import { NAV_LINKS, SITE } from '../../lib/site';
import Logo from '../Logo.astro';
import { MobileMenuButton } from '../islands/MobileMenu';
---

<header
	id="site-header"
	class="fixed inset-x-0 top-0 z-30 flex justify-center px-4 pt-4 transition-all duration-300 md:pt-6"
	data-state="top"
>
	<nav
		aria-label="Principal"
		class="group/header flex w-full max-w-[1168px] items-center justify-between gap-6 rounded-[12px] border border-transparent px-4 py-2.5 transition-all duration-300 data-[scrolled=true]:max-w-5xl data-[scrolled=true]:border-white/10 data-[scrolled=true]:bg-black/50 data-[scrolled=true]:backdrop-blur-xl"
		data-scrolled="false"
	>
		<Logo class="shrink-0" />

		<ul class="hidden items-center gap-8 lg:flex">
			{
				NAV_LINKS.map((link) => (
					<li>
						<a href={link.href} class="text-sm text-white/70 transition-colors hover:text-white">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<div class="flex items-center gap-3">
			<a
				href={SITE.subscriptionsUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex h-10 items-center gap-2 rounded-[12px] bg-white px-5 text-sm font-medium text-black transition-all hover:bg-white/90 active:scale-[0.98]"
			>
				Empieza tu chequeo
			</a>
			<MobileMenuButton client:load />
		</div>
	</nav>
</header>

<script>
	const initHeader = (): void => {
		const nav = document.querySelector('#site-header nav') as HTMLElement | null;
		if (!nav) return;

		const onScroll = (): void => {
			nav.dataset.scrolled = window.scrollY > 24 ? 'true' : 'false';
		};
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	};

	initHeader();
	document.addEventListener('astro:page-load', initHeader);
</script>
