---
const STEPS = [
	{
		number: '01',
		title: 'Reserva tu examen',
		description: 'Agenda tu cita de laboratorio cerca de ti. Nosotros nos encargamos del resto.',
		visual: 'calendar',
	},
	{
		number: '02',
		title: 'Recibe tus resultados',
		description:
			'Resultados claros y fáciles de entender, organizados por areas clave de tu salud.',
		visual: 'score',
	},
	{
		number: '03',
		title: 'Entiende en qué enfocarte',
		description:
			'Nuestro sistema de AI identifica desequilibrios con criterios médicos antes de que se conviertan en problemas.',
		visual: 'chart',
	},
	{
		number: '04',
		title: 'Inicia tu plan de salud',
		description: 'Un plan claro, racional y personalizado, revisado contigo por un médico.',
		visual: 'plan',
	},
] as const;
---

<section id="how-it-works" class="relative py-24 md:py-32">
	<div class="container-page">
		<div class="mx-auto max-w-3xl text-center">
			<h2
				class="font-display text-4xl font-light leading-[1.1] tracking-tight text-balance md:text-6xl"
			>
				Un chequeo de salud completo, sin complicaciones
			</h2>
			<p class="mx-auto mt-5 max-w-xl text-base text-white/60 md:text-lg">
				De una sola prueba a decisiones claras, con acompañamiento médico.
			</p>
		</div>

		<div class="mt-16 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6">
			{
				STEPS.map((step) => (
					<article class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02] p-6 transition-colors hover:bg-white/[0.04] md:p-8">
						<div class="flex items-start justify-between gap-6">
							<div class="max-w-md">
								<span class="text-sm font-medium text-white/40">{step.number}</span>
								<h3 class="mt-2 text-xl font-medium text-white md:text-2xl">
									{step.title}
								</h3>
								<p class="mt-3 text-sm text-white/60 md:text-base">{step.description}</p>
							</div>
						</div>

						<div class="mt-8">
							{step.visual === 'calendar' && (
								<div class="flex gap-2 overflow-hidden">
									{['Miércoles 08', 'Jueves 09', 'Viernes 10', 'Sábado 11', 'Domingo 12', 'Lunes 13', 'Martes 14'].map((day, idx) => {
										const [name, num] = day.split(' ');
										const isHighlight = idx === 3;
										return (
											<div
												class:list={[
													'flex shrink-0 flex-col items-center justify-center rounded-xl border px-3 py-3 text-center transition-colors',
													isHighlight
														? 'border-brand-500/40 bg-brand-500/15 text-white'
														: 'border-white/10 bg-white/[0.02] text-white/60',
												]}
											>
												<span class="text-[10px] uppercase tracking-wider">{name}</span>
												<span class="mt-1 text-lg font-medium">{num}</span>
											</div>
										);
									})}
								</div>
							)}
							{step.visual === 'score' && (
								<div class="flex gap-3">
									<div class="flex-1 rounded-xl border border-white/10 bg-black/40 p-4">
										<p class="text-[10px] uppercase tracking-wider text-white/40">
											Optimal Score
										</p>
										<p class="mt-2 text-3xl font-light text-white">87</p>
										<div class="mt-2 h-1 rounded-full bg-white/10">
											<div class="h-full w-[87%] rounded-full bg-success" />
										</div>
									</div>
									<div class="flex-1 rounded-xl border border-white/10 bg-black/40 p-4">
										<p class="text-[10px] uppercase tracking-wider text-white/40">
											Edad biológica
										</p>
										<p class="mt-2 text-3xl font-light text-white">36</p>
										<p class="mt-2 text-[10px] text-white/40">menor que la real</p>
									</div>
								</div>
							)}
							{step.visual === 'chart' && (
								<div class="rounded-xl border border-white/10 bg-black/40 p-4">
									<div class="flex items-center justify-between">
										<span class="text-[10px] uppercase tracking-wider text-white/40">
											Fuera de rango
										</span>
										<span class="text-[10px] uppercase tracking-wider text-success">
											Óptimo
										</span>
									</div>
									<svg viewBox="0 0 240 60" class="mt-2 h-12 w-full" aria-hidden="true">
										<polyline
											points="0,40 40,30 80,42 120,15 160,25 200,18 240,28"
											fill="none"
											stroke="currentColor"
											stroke-width="1.5"
											class="text-success"
										/>
										<circle cx="120" cy="15" r="3" class="fill-success" />
									</svg>
								</div>
							)}
							{step.visual === 'plan' && (
								<div class="grid grid-cols-3 gap-2">
									{[
										{ label: 'Alimentos', tone: 'from-emerald-500/30 to-emerald-700/10' },
										{ label: 'Suplementos', tone: 'from-brand-500/30 to-brand-700/10' },
										{ label: 'Salud diaria', tone: 'from-violet-500/30 to-violet-700/10' },
									].map((item) => (
										<div class={`rounded-xl border border-white/10 bg-gradient-to-b ${item.tone} p-3`}>
											<p class="text-xs font-medium text-white">{item.label}</p>
											<p class="mt-6 text-[10px] text-white/40">3 acciones</p>
										</div>
									))}
								</div>
							)}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
