---
import { DOCTORS, UNIVERSITIES, LABS } from '../../data/team';

const getInitials = (name: string): string =>
	name
		.replace(/,.*$/, '')
		.split(' ')
		.filter(Boolean)
		.slice(0, 2)
		.map((part) => part[0]?.toUpperCase() ?? '')
		.join('');
---

<section id="team" class="relative py-24 md:py-32">
	<div class="container-page">
		<div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:items-end">
			<div class="md:col-span-7">
				<h2
					class="font-display text-4xl font-light leading-[1.1] tracking-tight text-balance md:text-5xl"
				>
					Hecho con médicos. Basado en ciencia real.
				</h2>
				<p class="mt-5 max-w-xl text-base text-white/60 md:text-lg">
					Desde una amplia red de laboratorios hasta un equipo médico líder. Resultados
					claros, interpretados por médicos y validados en contexto clínico.
				</p>
			</div>

			<ul class="flex flex-wrap items-center gap-x-8 gap-y-4 md:col-span-5 md:justify-end">
				{
					UNIVERSITIES.map((u) => (
						<li class="text-xl font-light text-white/80 md:text-2xl" aria-label={u.name}>
							{/* TODO: replace with /images/universities/<slug>.svg when available */}
							{u.name}
						</li>
					))
				}
			</ul>
		</div>

		<div class="mt-12 md:mt-16">
			<ul
				class="flex snap-x gap-4 overflow-x-auto pb-4 [scrollbar-width:none] md:gap-5 [&::-webkit-scrollbar]:hidden"
			>
				{
					DOCTORS.map((doctor) => (
						<li class="w-[200px] shrink-0 snap-start md:w-[220px]">
							<div class="aspect-[3/4] overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-white/[0.06] to-white/[0.02]">
								{doctor.imageUrl ? (
									<img
										src={doctor.imageUrl}
										alt={`Foto de ${doctor.name}`}
										class="h-full w-full object-cover"
										loading="lazy"
									/>
								) : (
									<div class="flex h-full w-full items-center justify-center text-4xl font-light text-white/30">
										{getInitials(doctor.name)}
									</div>
								)}
							</div>
							<p class="mt-3 text-sm font-medium text-white">{doctor.name}</p>
							<p class="mt-1 text-xs text-white/60">
								{doctor.credentials}
								{doctor.institution ? `, ${doctor.institution}` : ''}
							</p>
						</li>
					))
				}
			</ul>
		</div>

		<div class="mt-20 text-center">
			<h3 class="text-lg font-medium text-white md:text-xl">
				Amplia red de laboratorios en toda Latinoamérica
			</h3>
			<ul
				class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-6 opacity-80"
			>
				{
					LABS.map((lab) => (
						<li class="text-sm font-light tracking-wider text-white/70 md:text-base" aria-label={lab.name}>
							{/* TODO: replace with /images/labs/<slug>.svg when logos are delivered */}
							{lab.name}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
