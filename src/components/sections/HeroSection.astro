---
import { SITE } from '../../lib/site';
import { HeroPrice, HeroDailyStat } from '../islands/HeroPrice';
---

<section
	id="hero"
	class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden pb-12 pt-32 md:pb-20 md:pt-40"
>
	<!-- Background media -->
	<div class="absolute inset-0 -z-10">
		{/* TODO: replace with the official Optimal hero video (looped, muted, ~1080p mp4 h.264). */}
		{/* Place file at public/videos/hero.mp4 with poster at public/images/hero-poster.jpg. */}
		<video
			class="hidden h-full w-full object-cover md:block"
			autoplay
			muted
			loop
			playsinline
			preload="metadata"
			poster="/images/hero-poster.jpg"
			aria-hidden="true"
		>
			<source src="/videos/hero.mp4" type="video/mp4" />
		</video>
		{/* TODO: replace with branded mobile poster (image-only fallback for perf on mobile). */}
		<img
			class="block h-full w-full object-cover md:hidden"
			src="/images/hero-poster.jpg"
			alt=""
			aria-hidden="true"
		/>
		<div
			class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/40 to-black"
			aria-hidden="true"
		>
		</div>
	</div>

	<div class="container-page">
		<div class="max-w-4xl">
			<h1
				class="font-display text-5xl font-light leading-[1.05] tracking-tight text-balance text-white md:text-7xl lg:text-[5.5rem]"
			>
				Entiende qué está pasando con tu salud hoy
			</h1>
			<p class="mt-6 max-w-xl text-base text-white/70 md:text-lg">
				Un chequeo de salud completo con más de 300 pruebas, resultados fáciles de
				entender y un plan claro para cuidarte mejor.<br />
				<HeroPrice client:load />
			</p>
			<div class="mt-8">
				<a
					href={SITE.subscriptionsUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex h-12 items-center gap-2 rounded-full bg-white px-7 text-sm font-medium text-black transition-all hover:bg-white/90 active:scale-[0.98]"
				>
					Empieza tu chequeo
				</a>
			</div>
		</div>

		<div
			class="mt-16 grid grid-cols-1 gap-x-8 gap-y-6 border-t border-white/10 pt-8 md:mt-20 md:grid-cols-3 md:items-end"
		>
			<div class="text-left">
				<p class="font-medium text-white">+300 pruebas</p>
				<p class="text-sm text-white/50">2 tomas por año</p>
			</div>
			<div class="text-left md:justify-self-center md:text-center">
				<p class="font-medium text-white">Cita médica</p>
				<p class="text-sm text-white/50">Incluida en el plan</p>
			</div>
			<div class="text-left md:justify-self-end md:text-right">
				<HeroDailyStat client:load />
			</div>
		</div>
	</div>
</section>
