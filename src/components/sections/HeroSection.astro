---
import { SITE } from '../../lib/site';
import { HeroPrice, HeroDailyStat } from '../islands/HeroPrice';
---

<section
	id="hero"
	class="relative isolate flex min-h-svh flex-col justify-end overflow-hidden pt-32 pb-12 md:pt-40 md:pb-20"
>
	<!-- Background media -->
	<div class="absolute inset-0 -z-10">
		{/* TODO: replace with the official Optimal hero video (looped, muted, ~1080p mp4 h.264). */}
		{/* Place file at public/videos/hero.mp4 with poster at public/images/hero-poster.jpg. */}
		<video
			class="hidden h-full w-full object-cover md:block"
			autoplay
			muted
			loop
			playsinline
			preload="metadata"
			poster="/images/hero-poster.jpg"
			aria-hidden="true"
		>
			<source src="/videos/hero.mp4" type="video/mp4" />
		</video>
		{/* TODO: replace with branded mobile poster (image-only fallback for perf on mobile). */}
		<img
			class="block h-full w-full object-cover md:hidden"
			src="/images/hero-poster.jpg"
			alt=""
			aria-hidden="true"
		/>
		<div
			class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/40 to-black"
			aria-hidden="true"
		>
		</div>
	</div>

	<div class="container-page">
		<div class="w-full">
			<div class="max-w-4xl">
				<h1
					class="font-display text-5xl leading-[1.05] font-light tracking-tight text-balance text-white md:text-7xl lg:text-[3.5rem]"
				>
					Entiende qué está pasando con tu salud hoy
				</h1>
				<p class="mt-6 max-w-2xl text-base text-white md:text-lg">
					Un chequeo de salud completo con más de 300 pruebas, resultados fáciles de entender y un
					plan claro para cuidarte mejor.<br />
					<HeroPrice client:load />
				</p>
			</div>
			<div class="mt-8 flex flex-row justify-between">
				<a
					href={SITE.subscriptionsUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex h-12 items-center gap-2 rounded-[12px] bg-white px-7 text-sm font-medium text-black transition-all hover:bg-white/90 active:scale-[0.98]"
				>
					Empieza tu chequeo
				</a>

				<div class="flex flex-row gap-x-8 gap-y-6 border-white/10 md:grid-cols-3 md:items-end">
					<div class="text-left text-white">
						<p class="font-medium">+300 pruebas</p>
						<p class="text-sm">2 tomas por año</p>
					</div>
					<div class="h-full border-l border-white/10"></div>
					<div class="text-left text-white">
						<p class="font-medium">Cita médica</p>
						<p class="text-sm">Incluida en el plan</p>
					</div>
					<div class="h-full border-l border-white/10"></div>
					<div class="text-left">
						<HeroDailyStat client:load />
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
