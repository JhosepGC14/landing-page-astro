---
import { BIOMARKER_CATEGORIES } from '../../data/biomarkers';
---

<section id="measure" class="relative py-24 md:py-32">
	<div class="container-page">
		<div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:items-end">
			<h2
				class="font-display text-4xl font-light leading-[1.1] tracking-tight text-balance md:col-span-7 md:text-5xl"
			>
				Una visión completa de tu salud, no exámenes aislados
			</h2>
			<p class="text-base text-white/60 md:col-span-5 md:text-lg">
				Evaluamos las principales dimensiones de tu salud para entender cómo trabajan en
				conjunto, y dónde vale la pena enfocar tu atención hoy.
			</p>
		</div>
	</div>

	<div class="relative mt-12 md:mt-16">
		<div
			class="flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-4 [scrollbar-width:none] md:gap-6 md:px-12 [&::-webkit-scrollbar]:hidden"
		>
			{
				BIOMARKER_CATEGORIES.map((category) => (
					<article
						class="group relative flex h-[420px] w-[300px] shrink-0 snap-start flex-col justify-between overflow-hidden rounded-2xl border border-white/10 p-6 md:h-[460px] md:w-[340px]"
					>
						{/* TODO: replace with /images/biomarkers/<slug>.jpg art direction shot */}
						<div
							class={`absolute inset-0 -z-10 bg-gradient-to-b ${category.gradient}`}
							aria-hidden="true"
						/>
						<div class="absolute inset-0 -z-10 bg-black/60" aria-hidden="true" />

						<div>
							<h3 class="font-display text-2xl font-light leading-tight text-white md:text-3xl">
								{category.title}
							</h3>
							<p class="mt-3 text-sm text-white/70">{category.description}</p>
						</div>

						<div>
							<p class="text-xs uppercase tracking-wider text-white/50">
								Incluye {category.count} biomarcador{category.count === 1 ? '' : 'es'}
							</p>
							<ul class="mt-3 flex flex-wrap gap-2">
								{category.highlights.slice(0, 4).map((biomarker) => (
									<li class="rounded-full border border-white/15 bg-white/[0.06] px-3 py-1 text-xs text-white/80">
										{biomarker}
									</li>
								))}
								{category.count > category.highlights.length && (
									<li class="rounded-full border border-white/10 bg-white/[0.02] px-3 py-1 text-xs text-white/50">
										{category.count - category.highlights.length} biomarcadores más
									</li>
								)}
							</ul>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
