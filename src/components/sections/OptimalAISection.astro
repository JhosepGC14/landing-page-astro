---
---

<section
	id="optimal-ai"
	class="relative isolate overflow-hidden py-24 md:py-32"
>
	<!-- Background glows -->
	<div
		class="absolute inset-x-0 top-1/2 -z-10 h-[600px] -translate-y-1/2 bg-[radial-gradient(60%_50%_at_30%_50%,rgba(168,85,247,0.18),transparent_70%),radial-gradient(50%_45%_at_70%_50%,rgba(255,90,31,0.18),transparent_70%)]"
		aria-hidden="true"
	>
	</div>

	<div class="container-page">
		<div class="mx-auto max-w-3xl text-center">
			<h2
				class="font-display text-4xl font-light leading-[1.1] tracking-tight text-balance md:text-6xl"
			>
				Entiende tu salud al instante y obtén un plan para transformarla
			</h2>
		</div>

		<div class="relative mx-auto mt-16 flex max-w-md justify-center">
			{/* TODO: replace this composed mockup with the real branded Optimal AI screenshot/render */}
			<div class="relative">
				<div
					class="relative h-[500px] w-[260px] rounded-[2.5rem] border border-white/10 bg-gradient-to-b from-white/[0.06] to-white/[0.02] p-3 shadow-2xl shadow-black/60"
				>
					<div
						class="relative h-full w-full overflow-hidden rounded-[2rem] bg-black"
					>
						<div
							class="absolute inset-0 bg-[radial-gradient(40%_30%_at_50%_50%,rgba(168,85,247,0.5),transparent_70%)]"
						>
						</div>

						<div class="absolute inset-0 flex flex-col items-center justify-center px-6">
							<p class="font-display text-3xl font-light tracking-tight text-white">
								Optimal <span class="text-white/60">AI</span>
							</p>
						</div>

						<div class="absolute bottom-3 left-3 right-3 flex items-center gap-2 rounded-full border border-white/10 bg-black/70 p-2 pl-4 backdrop-blur">
							<input
								type="text"
								placeholder="¿Qué exámenes adicionales tendría sentido pedir y por qué?"
								class="flex-1 truncate bg-transparent text-[10px] text-white/70 outline-none placeholder:text-white/40"
								disabled
								aria-label="Vista previa del prompt"
							/>
							<button
								type="button"
								class="rounded-full bg-white px-3 py-1.5 text-[10px] font-medium text-black"
								disabled
								tabindex="-1"
							>
								Enviar
							</button>
						</div>
					</div>
				</div>

				<div
					class="absolute -inset-12 -z-10 bg-[radial-gradient(50%_50%_at_50%_50%,rgba(168,85,247,0.25),transparent_70%)]"
					aria-hidden="true"
				>
				</div>
			</div>
		</div>
	</div>
</section>
