---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';

interface Props {
	title: string;
	description: string;
	updatedAt: string;
	heroTone?: 'red' | 'amber';
}

const { title, description, updatedAt, heroTone = 'red' } = Astro.props;

const heroToneClasses: Record<'red' | 'amber', string> = {
	red: 'bg-[radial-gradient(60%_50%_at_50%_30%,rgba(220,40,40,0.4),transparent_60%),radial-gradient(80%_60%_at_50%_60%,rgba(120,20,20,0.5),transparent_70%)]',
	amber:
		'bg-[radial-gradient(60%_50%_at_50%_30%,rgba(220,140,40,0.4),transparent_60%),radial-gradient(80%_60%_at_50%_60%,rgba(120,60,20,0.5),transparent_70%)]',
};
---

<BaseLayout title={`${title} — Optimal`} description={description}>
	<Header />
	<main id="main">
		<section class="relative isolate pt-32 md:pt-40">
			<div class="absolute inset-0 -z-10" aria-hidden="true">
				{/* TODO: replace with real /images/legal-bg-{heroTone}.jpg art if delivered */}
				<div class={`absolute inset-0 ${heroToneClasses[heroTone]}`}></div>
				<div class="absolute inset-0 bg-black/40"></div>
				<div
					class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-b from-transparent to-black"
				>
				</div>
			</div>

			<div class="container-page text-center">
				<h1
					class="font-display text-4xl font-light leading-[1.05] tracking-tight text-balance md:text-6xl"
				>
					{title}
				</h1>
				<p class="mt-4 text-sm text-white/60">Última actualización: {updatedAt}</p>
			</div>

			<article
				class="container-page prose prose-invert prose-headings:font-display prose-headings:font-medium prose-h2:mt-12 prose-h2:text-2xl prose-h3:mt-8 prose-h3:text-xl prose-h4:mt-6 prose-h4:text-base prose-p:text-white/70 prose-li:text-white/70 prose-strong:text-white prose-a:text-brand-300 mx-auto mt-16 max-w-3xl pb-24 text-base md:mt-20 md:pb-32"
			>
				<slot />
			</article>
		</section>
	</main>
	<Footer />
</BaseLayout>
