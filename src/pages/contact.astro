---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import { ContactForm } from '../components/islands/ContactForm';
---

<BaseLayout
	title="Contacto — Optimal"
	description="Habla con el equipo de Optimal. Una conversación puede cambiar tu trayectoria de salud."
>
	<Header />
	<main id="main">
		<section class="relative isolate overflow-hidden pt-32 pb-24 md:pt-40 md:pb-32">
			<!-- Warm aurora-like background to match the reference visual -->
			<div class="absolute inset-0 -z-10" aria-hidden="true">
				{/* TODO: replace with /images/contact-aurora.jpg if a hand-crafted background is delivered */}
				<div
					class="absolute inset-0 bg-[radial-gradient(60%_50%_at_30%_30%,rgba(255,160,40,0.45),transparent_60%),radial-gradient(50%_45%_at_75%_40%,rgba(220,40,80,0.35),transparent_60%),radial-gradient(70%_50%_at_50%_85%,rgba(120,30,180,0.25),transparent_70%)]"
				>
				</div>
				<div class="absolute inset-0 bg-black/40"></div>
				<div
					class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-b from-transparent to-black"
				>
				</div>
			</div>

			<div class="container-page">
				<div class="mx-auto max-w-2xl text-center">
					<h1
						class="font-display text-4xl font-light leading-[1.05] tracking-tight text-balance md:text-6xl"
					>
						Habla con el equipo
					</h1>
					<p class="mx-auto mt-5 max-w-xl text-base text-white/80 md:text-lg">
						Una conversación puede cambiar tu trayectoria de salud. Escríbenos y empezamos.
					</p>
				</div>

				<div
					class="mx-auto mt-12 max-w-2xl rounded-2xl border border-white/10 bg-black/60 p-6 backdrop-blur-sm md:mt-16 md:p-10"
				>
					<ContactForm client:load />
				</div>
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>
